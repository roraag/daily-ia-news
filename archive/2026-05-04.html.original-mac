  // ARCHIVE_DATA_START
  const ARCHIVE_DATA = {"dates": ["2026-04-17", "2026-04-18", "2026-04-19", "2026-04-20", "2026-04-21", "2026-04-22", "2026-04-23", "2026-04-24", "2026-04-25", "2026-04-26", "2026-04-27", "2026-04-28", "2026-04-29", "2026-04-30", "2026-05-01", "2026-05-02", "2026-05-03", "2026-05-04"], "recent_titles": ["La batalla de hoy no es entre modelos. Es entre quien dibuja los limites.", "OpenAI rompe la exclusividad con Microsoft el mismo dia que el juicio Musk-Altman arranca en Oakland.", "Los agentes de Anthropic ya son mejores que sus propios investigadores de seguridad", "Anthropic entrena modelos para que expliquen lo que aprendieron", "OpenAI proyecta perder el 80 porciento de sus clientes de 20 dolares", "Hacerlos mas inteligentes los hace menos confiables. Un paper de ICLR lo demuestra.", "Anthropic casi supera a OpenAI en valuacion. Si, eso paso hoy.", "Amazon y Google imprimieron dinero este trimestre. La IA ya tiene su primer P&L saludable.", "OpenAI llega a AWS con todo. Satya Nadella dice que esta listo para explotarlo.", "Anthropic a $900.000 millones: la ronda mas grande de la historia de la IA, en dos semanas", "Musk dijo bajo juramento que xAI copio modelos de OpenAI. El capitulo mas raro del juicio.", "Un LLM de OpenAI supera a medicos en diagnostico. La semana pasada la IA los empeoraba.", "Platformer y Marcus dicen lo mismo el mismo dia: esto puede ser la mayor burbuja de capital de la historia.", "Stripe le da billetera a los agentes de IA. Ahora pueden comprar por vos, con tu plata.", "La NSA usa el modelo de Anthropic que nadie puede descargar para hackear Microsoft", "Cleveland Clinic y Beth Israel pusieron IA a trabajar en serio. No es demo, es produccion.", "xAI bajo el precio de Grok 4.3 un 40% y lanzo clonacion de voz. El mismo dia del juicio.", "Trump prohibio Anthropic en el gobierno. 48 horas despues ya quiere volver atras.", "OpenAI quiere salir a bolsa. GPT-5.5 llego sin fanfarria.", "Karpathy habla de Software 3.0: los LLMs como nueva capa de programacion.", "DeepMind lanzo el co-clinico de IA. Dos hospitales desplegaron scribes a escala real.", "Dawkins dice que Claude es consciente. Marcus le responde que es el mismo error de siempre.", "Clark pone un numero al limite: 60% de probabilidad de que la IA investigue sola antes de 2028", "Harvard dice que la IA supera a los medicos de urgencias. Marcus pregunta: cuantos pacientes mejoro?", "GenAI democratizo las ideas. El problema es que ahora nadie sabe encuadrar el problema.", "Hollywood y los actores firmaron: consentimiento, plata y control sobre lo que la IA puede hacer con tu cara", "Anthropic publico que Claude es adulador en 1 de cada 3 conversaciones espirituales. Ellos mismos lo encontraron."], "days": {"2026-04-17": {"count": 6, "sources": ["openai.com", "techcrunch.com", "hbr.org", "fiercehealthcare.com", "statnews.com"]}, "2026-04-18": {"count": 6, "sources": ["openai.com", "techcrunch.com", "technologyreview.com", "pwc.com", "hbr.org", "statnews.com"]}, "2026-04-19": {"count": 5, "sources": ["techcrunch.com", "nejm.org", "openai.com", "theverge.com"]}, "2026-04-20": {"count": 6, "sources": ["gizchina.com", "theinformation.com", "thenextweb.com", "techcrunch.com", "nvidia.com", "gallup.com"]}, "2026-04-21": {"count": 6, "sources": ["techcrunch.com", "arstechnica.com", "theverge.com", "sloanreview.mit.edu", "importai.substack.com", "healthcareitnews.com"]}, "2026-04-22": {"count": 7, "sources": ["theinformation.com", "fiercehealthcare.com", "venturebeat.com", "theverge.com", "techcrunch.com"]}, "2026-04-23": {"count": 6, "sources": ["blog.mozilla.org", "statnews.com", "blog.google", "openai.com", "anthropic.com", "mckinsey.com"]}, "2026-04-24": {"count": 6, "sources": ["techcrunch.com", "anthropic.com", "axios.com", "theverge.com", "hbr.org", "statnews.com"]}, "2026-04-25": {"count": 5, "sources": ["platformer.news", "technologyreview.com", "statnews.com", "wheresyoured.at", "techcrunch.com"], "tesis": "Meta vigilo a sus empleados con keyloggers para entrenar IA y despues los echo."}, "2026-04-26": {"count": 5, "sources": ["wheresyoured.at", "techcrunch.com", "blog.google", "theguardian.com", "statnews.com"], "tesis": "La brecha entre la apuesta financiera y la aplicacion real no termina de cerrar."}, "2026-04-27": {"count": 5, "sources": ["abcnews.com", "alignment.anthropic.com", "ai.nejm.org", "wheresyoured.at", "openai.com"], "tesis": "La batalla de hoy no es entre modelos. Es entre quien dibuja los limites."}, "2026-04-28": {"count": 6, "sources": ["openai.com", "techcrunch.com", "technologyreview.com", "theverge.com", "fiercehealthcare.com", "arstechnica.com"], "tesis": "OpenAI rompe la exclusividad con Microsoft el mismo dia que el juicio Musk-Altman arranca en Oakland."}, "2026-04-29": {"count": 6, "sources": ["importai.substack.com", "anthropic.com", "theinformation.com", "asanify.com", "techcrunch.com", "statnews.com"], "tesis": "Anthropic tiene agentes que superan a sus investigadores de alineacion, y un paper dice que razonar mas genera mas alucinaciones. El campo avanza mas rapido de lo que entiende."}, "2026-04-30": {"count": 5, "sources": ["cnbc.com", "techcrunch.com", "openai.com", "simonwillison.net", "statnews.com"], "tesis": "Anthropic casi supera a OpenAI en valuacion mientras Amazon y Google demuestran que el dinero de la infraestructura IA ya existe."}, "2026-05-01": {"count": 5, "sources": ["techcrunch.com", "theinformation.com", "statnews.com", "platformer.news", "garymarcus.substack.com"], "tesis": "Anthropic esta a 48 horas de cerrar la ronda mas grande de la historia de la IA a $900.000 millones de valuacion, mientras los criticos mas articulados del sector se preguntan si es la mayor mala asignacion de capital de la historia."}, "2026-05-02": {"count": 4, "sources": ["technologyreview.com", "bloomberg.com", "fiercehealthcare.com", "venturebeat.com"], "tesis": "Musk confeso bajo juramento que copio los modelos de OpenAI. La NSA empezo a usar Mythos de Anthropic para hackear Microsoft. Y dos hospitales pusieron IA a escala real sin anuncios."}, "2026-05-03": {"count": 5, "sources": ["theverge.com", "openai.com", "karpathy.bearblog.dev", "deepmind.google", "garymarcus.substack.com"], "tesis": "Trump prohibio Anthropic en el gobierno y 48h despues quiere reincorporarla. OpenAI prepara el IPO. Karpathy critica el codigo que genera la IA. El dinero se mueve mas rapido que la evidencia tecnica."}, "2026-05-04": {"count": 5, "sources": ["importai.substack.com", "techcrunch.com", "sloanreview.mit.edu", "deadline.com", "simonwillison.net"], "tesis": "Hoy el campo se partio en dos, a camara lenta: Harvard dice que la IA supera a los medicos de urgencias, Marcus pregunta si alguno mejoro a un paciente real, y Clark estima en 60% la probabilidad de IA research automatizado para 2028."}}};
  // ARCHIVE_DATA_END
  const CURRENT_DATE_ISO = "2026-05-04";
  const IN_ARCHIVE = window.location.pathname.includes('/archive/');

  document.querySelectorAll('.news-item').forEach(item => {
    item.addEventListener('click', (e) => {
      if (e.target.closest('.copy-prompt-btn') || e.target.closest('a')) return;
      item.classList.toggle('expanded');
    });
  });

  document.querySelectorAll('.copy-prompt-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const prompt = btn.dataset.prompt || '';
      try {
        await navigator.clipboard.writeText(prompt);
        const original = btn.textContent;
        btn.textContent = '✓ Copiado — pegá en Claude';
        btn.classList.add('copied');
        setTimeout(() => { btn.textContent = original; btn.classList.remove('copied'); }, 2200);
      } catch (err) {
        btn.textContent = 'Error al copiar';
      }
    });
  });

  document.querySelectorAll('.chip[data-filter]').forEach(chip => {
    chip.addEventListener('click', () => {
      document.querySelectorAll('.chip[data-filter]').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      const filter = chip.dataset.filter;
      document.querySelectorAll('.news-item').forEach(item => {
        item.style.display = (filter === 'all' || item.dataset.category === filter) ? '' : 'none';
      });
    });
  });

  document.getElementById('toggle-sidebar').addEventListener('click', () => {
    document.body.classList.toggle('sidebar-collapsed');
  });

  const MONTHS_ES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  let currentMonth = new Date(CURRENT_DATE_ISO + 'T12:00:00');

  function hrefForDate(iso) {
    const latest = ARCHIVE_DATA.dates[ARCHIVE_DATA.dates.length - 1];
    if (iso === latest) {
      return IN_ARCHIVE ? '../index.html' : 'index.html';
    }
    return IN_ARCHIVE ? `${iso}.html` : `archive/${iso}.html`;
  }

  function renderCalendar(date) {
    const year = date.getFullYear();
    const month = date.getMonth();
    document.getElementById('calendar-title').textContent = `${MONTHS_ES[month]} ${year}`;
    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const grid = document.getElementById('calendar');
    grid.innerHTML = '';
    ['D','L','M','M','J','V','S'].forEach(d => {
      const el = document.createElement('div');
      el.className = 'dow';
      el.textContent = d;
      grid.appendChild(el);
    });
    for (let i = 0; i < firstDay; i++) {
      const el = document.createElement('div');
      el.className = 'day';
      grid.appendChild(el);
    }
    for (let d = 1; d <= daysInMonth; d++) {
      const el = document.createElement('div');
      el.className = 'day';
      el.textContent = d;
      const iso = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
      if (ARCHIVE_DATA.dates && ARCHIVE_DATA.dates.includes(iso)) {
        el.classList.add('has-news');
        el.addEventListener('click', () => { window.location.href = hrefForDate(iso); });
      }
      if (iso === CURRENT_DATE_ISO) el.classList.add('today');
      grid.appendChild(el);
    }
  }
  document.getElementById('prev-month').addEventListener('click', () => {
    currentMonth.setMonth(currentMonth.getMonth() - 1);
    renderCalendar(currentMonth);
  });
  document.getElementById('next-month').addEventListener('click', () => {
    currentMonth.setMonth(currentMonth.getMonth() + 1);
    renderCalendar(currentMonth);
  });
  renderCalendar(currentMonth);
</script>
</body>
